{
  "manifest_version": 3,
  "name": "诗语翻译 - AI 智能翻译助手",
  "version": "1.1",
  "description": "诗语翻译：支持全球顶级大模型的沉浸式双语对照翻译",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://shiyuai.top/*", "*://*.shiyuai.top/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://shiyuai.top/*"],
      "js": ["auth-relay.js"],
      "run_at": "document_end"
    }
  ]
}
