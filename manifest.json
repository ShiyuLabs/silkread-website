{
  "manifest_version": 3,
  "name": "SilkRead",
  "version": "1.4.6",
  "description": "SilkRead: immersive AI-powered bilingual web translation for global readers.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://getsilkread.com/*",
    "https://www.getsilkread.com/*",
    "https://api.getsilkread.com/*",
    "https://*.microsoft.com/*",
    "https://*.microsofttranslator.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://getsilkread.com/*", "https://www.getsilkread.com/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": ["https://getsilkread.com/*", "https://www.getsilkread.com/*"],
      "js": ["auth-relay.js"],
      "run_at": "document_end"
    }
  ]
}
